{
  "name": "indus-reserve-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:customer": "npm --workspace apps/customer-web run dev",
    "dev:admin": "npm --workspace apps/admin-web run dev",
    "dev:partner": "npm --workspace apps/partner-web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  }
}
